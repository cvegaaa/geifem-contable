# Variables para docker compose. Copiar a .env (nunca versionar .env).
# Contraseña de Mongo: usa solo letras y números (va dentro de la URI de conexión).
MONGO_USUARIO=geifem
MONGO_PASSWORD=CambiaEstaClave123
MONGO_PUERTO=27017
DB_NAME=geifem_contable

# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-este-secreto-por-uno-de-al-menos-32-caracteres
ENTORNO=produccion
# true exige HTTPS (los navegadores aceptan cookies Secure en http://localhost).
COOKIE_SECURE=true
REGISTRO_ABIERTO=true
PUERTO_WEB=8080

# Respaldos diarios de Mongo (hora local, días que se conservan, y copia externa opcional con rclone).
RESPALDO_HORA=03:00
RESPALDO_DIAS=14
RESPALDO_RCLONE=

# Correo saliente para enviar facturas a los clientes (opcional; sin SMTP_HOST el envío avisa que no está configurado).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_PASSWORD=
SMTP_REMITENTE=facturacion@tuempresa.co
SMTP_STARTTLS=true
SMTP_SSL=false
